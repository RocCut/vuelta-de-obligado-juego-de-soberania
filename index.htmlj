<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Defensa de Obligado - 20 de Noviembre</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Montserrat:wght@400;700;900&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        arcade: ['"Press Start 2P"', 'monospace'],
                        sans: ['Montserrat', 'sans-serif']
                    },
                    colors: {
                        patria: {
                            celeste: '#75AADB',
                            azul: '#1B365D',
                            oscuro: '#0B132B',
                            dorado: '#F6B40E',
                            rojo: '#E63946'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #060B19;
            color: #FFFFFF;
            user-select: none;
            overflow: hidden;
            touch-action: manipulation;
        }
        canvas {
            background: #0f172a;
            touch-action: none;
        }
        .touch-btn {
            box-shadow: 0 6px 0 #000;
            transition: all 0.1s ease;
        }
        .touch-btn:active {
            transform: translateY(4px);
            box-shadow: 0 2px 0 #000;
        }
    </style>
</head>
<body class="h-screen w-screen flex flex-col justify-between font-sans select-none overflow-hidden">

    <!-- HEADER: MARCADOR SUPERIOR -->
    <header class="bg-patria-oscuro border-b-2 border-patria-celeste px-3 py-2 flex justify-between items-center shadow-lg shrink-0">
        <div class="flex items-center gap-2">
            <i class="fa-solid fa-shield-halved text-patria-celeste text-lg"></i>
            <div>
                <h1 class="text-xs sm:text-sm font-black text-white leading-none">DEFENSA DE OBLIGADO</h1>
                <span class="text-[9px] text-patria-celeste font-bold">20 DE NOVIEMBRE</span>
            </div>
        </div>

        <!-- Estadísticas Rápidas -->
        <div class="flex items-center gap-3 text-xs font-mono bg-slate-900 px-3 py-1 rounded-lg border border-slate-700">
            <div>
                <span class="text-slate-400 text-[10px]">CADENAS:</span>
                <span id="ui-chain" class="font-bold text-emerald-400">100%</span>
            </div>
            <div class="h-3 w-px bg-slate-700"></div>
            <div>
                <span class="text-slate-400 text-[10px]">REPELIDOS:</span>
                <span id="ui-score" class="font-bold text-amber-400">0 / 100</span>
            </div>
        </div>
    </header>

    <!-- ÁREA DE JUEGO / CANVAS -->
    <main class="flex-grow relative w-full h-full bg-slate-950 flex flex-col items-center justify-center overflow-hidden">
        
        <!-- Mensaje emergente corto -->
        <div id="game-alert" class="absolute top-2 z-20 bg-slate-900/90 border border-patria-celeste px-3 py-1 rounded-full text-center shadow-lg transition-all duration-300 transform scale-0 opacity-0 pointer-events-none">
            <span id="alert-text" class="text-xs font-bold text-patria-dorado">¡Dispara con el botón FUEGO!</span>
        </div>

        <canvas id="gameCanvas" class="w-full h-full block"></canvas>
    </main>

    <!-- PANEL INFERIOR DE CONTROLES TÁCTILES -->
    <footer class="bg-slate-900/95 border-t border-slate-800 p-3 flex justify-around items-center gap-2 z-30 shrink-0">
        <button id="btn-chain" class="touch-btn flex-1 bg-amber-600 hover:bg-amber-500 active:bg-amber-700 text-white font-black py-3 px-2 rounded-xl text-xs flex items-center justify-center gap-2 border-2 border-amber-400 uppercase tracking-wider">
            <i class="fa-solid fa-wrench text-base"></i>
            <span>Reforzar Cadena</span>
        </button>
        <button id="btn-fire" class="touch-btn flex-1 bg-patria-rojo hover:bg-red-500 active:bg-red-700 text-white font-black py-3 px-2 rounded-xl text-sm flex items-center justify-center gap-2 border-2 border-red-300 uppercase tracking-wider">
            <i class="fa-solid fa-crosshair text-lg"></i>
            <span>¡FUEGO!</span>
        </button>
    </footer>

    <!-- MODAL RELATO DE HISTORIA (CUENTO EDUCATIVO PROGRESIVO) -->
    <div id="modal-story" class="fixed inset-0 bg-slate-950/90 backdrop-blur-md z-40 hidden flex items-center justify-center p-4">
        <div class="bg-slate-900 text-white rounded-2xl max-w-sm w-full p-5 shadow-2xl border-2 border-patria-dorado text-center relative overflow-hidden">
            <div class="absolute -top-10 -right-10 w-24 h-24 bg-patria-dorado/10 rounded-full blur-xl"></div>
            <span id="story-chapter" class="text-[10px] font-bold uppercase tracking-widest text-patria-celeste bg-slate-800 px-3 py-1 rounded-full inline-block mb-3 border border-slate-700">HISTORIA EN EL RÍO</span>
            
            <h3 id="story-title" class="text-base font-black text-patria-dorado mb-2">¡Comienza la Resistencia!</h3>
            <p id="story-body" class="text-xs text-slate-200 leading-relaxed my-3 font-sans italic">
                Texto del capítulo...
            </p>

            <button onclick="resumeGame();" class="w-full mt-2 bg-patria-celeste hover:bg-sky-500 text-slate-950 font-black py-2.5 rounded-xl text-xs uppercase tracking-wider transition-colors shadow-lg">
                Continuar Combate <i class="fa-solid fa-play ml-1"></i>
            </button>
        </div>
    </div>

    <!-- MODAL FINAL (RESULTADO DE LA BATALLA) -->
    <div id="modal-edition" class="fixed inset-0 bg-slate-950/95 backdrop-blur-md z-50 hidden flex items-center justify-center p-4">
        <div class="bg-slate-900 text-white rounded-2xl max-w-md w-full p-5 shadow-2xl border-2 border-patria-celeste text-center">
            
            <i class="fa-solid fa-flag-checkered text-4xl text-patria-dorado mb-2"></i>
            <h2 id="modal-title" class="text-xl font-black text-white uppercase tracking-tight">¡RESISTENCIA HEROICA!</h2>
            <p id="modal-desc" class="text-xs text-slate-300 mt-2 leading-relaxed">
                Las cadenas de Obligado soportaron el embate invasor. La resistencia demostró la firmeza argentina sobre sus ríos interiores.
            </p>

            <div class="bg-slate-800 p-3 rounded-xl my-4 text-xs font-mono flex justify-around">
                <div>
                    <span class="text-slate-400 block text-[10px]">HUNDIDOS/REPELIDOS</span>
                    <span id="final-score" class="text-base font-bold text-amber-400">0</span>
                </div>
                <div>
                    <span class="text-slate-400 block text-[10px]">RESISTENCIA CADENAS</span>
                    <span id="final-chain" class="text-base font-bold text-emerald-400">100%</span>
                </div>
            </div>

            <button onclick="resetGame(); closeModal();" class="w-full bg-patria-celeste hover:bg-sky-500 text-slate-950 font-black py-3 rounded-xl text-sm uppercase transition-colors">
                Volver a Defender el Río
            </button>
        </div>
    </div>

    <!-- SCRIPT DE LÓGICA Y JUEGO ARCADE -->
    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');

        let chainHP = 100;
        let score = 0;
        let gameOver = false;
        let gamePaused = false;
        const TARGET_SCORE = 100;
        let currentChapterIndex = 0;

        // Capítulos del Cuento / Historia de Soberanía
        const storyChapters = [
            {
                trigger: 10,
                title: "1. Flotas Extranjeras en el Paraná",
                text: "En 1845, las potencias de Gran Bretaña y Francia pretendían navegar nuestros ríos interiores sin permiso ni pagar tributos. Buscaban imponer el comercio sin respetar la soberanía argentina."
            },
            {
                trigger: 25,
                title: "2. La Estrategia de las Cadenas",
                text: "Para frenar el avance de más de 90 buques mercantes y de guerra, el General Lucio Mansilla tendió tres gruesas cadenas de hierro cruzando el Río Paraná, sostenidas sobre 24 barcones de madera."
            },
            {
                trigger: 40,
                title: "3. Artillería en las Barrancas",
                text: "En las altas barrancas de San Pedro se apostaron 4 baterías de cañones con nombres patrios: Manuel Belgrano, General Mansilla, General Zapiola y Eduardo Brown."
            },
            {
                trigger: 60,
                title: "4. Horas de Resistencia Heroica",
                text: "Durante casi 10 horas de combate desproporcionado, los patriotas impidieron el paso fácil de las potencias navales. Aunque las cadenas cedieron, la flota enemiga quedó muy dañada."
            },
            {
                trigger: 80,
                title: "5. Triunfo Diplomático",
                text: "La firme resistencia demostró que navegar nuestros ríos no sería gratis. Años después, las potencias tuvieron que devolver la isla de Martín García y firmar tratados reconociendo la soberanía nacional."
            },
            {
                trigger: 100,
                title: "6. El Significado del 20 de Noviembre",
                text: "Hoy conmemoramos la Batalla de Vuelta de Obligado como el Día de la Soberanía Nacional: el derecho independiente de un pueblo a defender sus ríos, tierras y recursos estratégicos."
            }
        ];

        let ships = [];
        let particles = [];
        let shots = [];

        // Ángulo del cañón (Apuntado)
        let cannonAngle = -Math.PI / 4;

        function resizeCanvas() {
            canvas.width = canvas.parentElement.clientWidth;
            canvas.height = canvas.parentElement.clientHeight;
        }

        window.addEventListener('resize', resizeCanvas);

        // Clases de Entidades
        class Ship {
            constructor() {
                this.x = -50;
                this.y = Math.random() * (canvas.height * 0.4) + (canvas.height * 0.2);
                this.speed = Math.random() * 0.8 + 0.6;
                this.width = 45;
                this.height = 20;
                this.hp = 2;
            }

            update() {
                const chainX = canvas.width * 0.65;
                if (this.x < chainX - 35) {
                    this.x += this.speed;
                } else {
                    // Daña la cadena si llega
                    chainHP -= 0.12;
                    if (Math.random() < 0.1) createSparks(this.x + 20, this.y);
                }
            }

            draw() {
                ctx.save();
                ctx.translate(this.x, this.y);

                // Casco del barco
                ctx.fillStyle = "#334155";
                ctx.beginPath();
                ctx.moveTo(0, 8);
                ctx.lineTo(35, 8);
                ctx.lineTo(45, 18);
                ctx.lineTo(5, 18);
                ctx.closePath();
                ctx.fill();

                // Mástil y chimenea
                ctx.fillStyle = "#94a3b8";
                ctx.fillRect(18, -6, 3, 14);

                // Bandera enemiga
                ctx.fillStyle = "#ef4444";
                ctx.fillRect(2, 0, 7, 5);

                ctx.restore();
            }
        }

        function createSparks(x, y) {
            for (let i = 0; i < 4; i++) {
                particles.push({
                    x: x, y: y,
                    vx: (Math.random() - 0.5) * 4,
                    vy: (Math.random() - 0.5) * 4,
                    life: 15,
                    color: '#f59e0b'
                });
            }
        }

        // Disparar Cañón
        function fireCannon() {
            if (gameOver || gamePaused) return;

            const cannonX = canvas.width * 0.85;
            const cannonY = canvas.height * 0.75;

            shots.push({
                x: cannonX,
                y: cannonY,
                vx: Math.cos(cannonAngle) * 15,
                vy: Math.sin(cannonAngle) * 15
            });

            createSparks(cannonX + Math.cos(cannonAngle)*20, cannonY + Math.sin(cannonAngle)*20);
        }

        // Reparar Cadenas
        function repairChains() {
            if (gameOver || gamePaused) return;
            chainHP = Math.min(100, chainHP + 14);
            createSparks(canvas.width * 0.65, canvas.height * 0.5);
            showAlert("¡CADENA TENSADA Y REFORZADA!");
        }

        document.getElementById('btn-fire').addEventListener('click', fireCannon);
        document.getElementById('btn-chain').addEventListener('click', repairChains);

        function showAlert(msg) {
            const el = document.getElementById('game-alert');
            document.getElementById('alert-text').textContent = msg;
            el.classList.remove('scale-0', 'opacity-0');
            el.classList.add('scale-100', 'opacity-100');
            clearTimeout(window.alertTimer);
            window.alertTimer = setTimeout(() => {
                el.classList.remove('scale-100', 'opacity-100');
                el.classList.add('scale-0', 'opacity-0');
            }, 2000);
        }

        function checkStoryTrigger() {
            if (currentChapterIndex < storyChapters.length) {
                let chapter = storyChapters[currentChapterIndex];
                if (score >= chapter.trigger) {
                    showStoryModal(chapter);
                    currentChapterIndex++;
                }
            }
        }

        function showStoryModal(chapter) {
            gamePaused = true;
            document.getElementById('story-chapter').textContent = `CAPÍTULO ${currentChapterIndex + 1} DE ${storyChapters.length}`;
            document.getElementById('story-title').textContent = chapter.title;
            document.getElementById('story-body').textContent = `"${chapter.text}"`;
            document.getElementById('modal-story').classList.remove('hidden');
        }

        function resumeGame() {
            document.getElementById('modal-story').classList.add('hidden');
            gamePaused = false;
            requestAnimationFrame(gameLoop);
        }

        // Bucle del juego
        function gameLoop() {
            if (gameOver || gamePaused) return;

            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // 1. DIBUJAR RÍO PARANÁ
            ctx.fillStyle = "#0284c7";
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // 2. DIBUJAR BARRANCA DE SAN PEDRO (Costa Derecha)
            ctx.fillStyle = "#15803d";
            ctx.beginPath();
            ctx.moveTo(canvas.width * 0.75, 0);
            ctx.lineTo(canvas.width, 0);
            ctx.lineTo(canvas.width, canvas.height);
            ctx.lineTo(canvas.width * 0.75, canvas.height);
            ctx.quadraticCurveTo(canvas.width * 0.7, canvas.height * 0.5, canvas.width * 0.75, 0);
            ctx.fill();

            // 3. DIBUJAR LAS CADENAS DEFENSIVAS
            const chainX = canvas.width * 0.65;
            ctx.strokeStyle = chainHP > 30 ? "#e2e8f0" : "#ef4444";
            ctx.lineWidth = 5;
            ctx.setLineDash([10, 6]);
            ctx.beginPath();
            ctx.moveTo(chainX, 0);
            ctx.lineTo(chainX, canvas.height);
            ctx.stroke();
            ctx.setLineDash([]);

            // Lanchones de soporte
            for (let y = 30; y < canvas.height; y += 60) {
                ctx.fillStyle = "#78350f";
                ctx.fillRect(chainX - 8, y, 16, 8);
            }

            // Posición del Cañón
            const cannonX = canvas.width * 0.85;
            const cannonY = canvas.height * 0.75;

            // 4. APUNTADO AUTOMÁTICO AL BARCO MÁS CERCANO O MÁS AVANZADO
            if (ships.length > 0) {
                let targetShip = ships[0];
                for (let s of ships) {
                    if (s.x > targetShip.x) {
                        targetShip = s;
                    }
                }
                let dx = targetShip.x - cannonX;
                let dy = targetShip.y - cannonY;
                cannonAngle = Math.atan2(dy, dx);
            } else {
                cannonAngle = -Math.PI * 0.8;
            }

            // Dibujar Cañón
            ctx.save();
            ctx.translate(cannonX, cannonY);
            ctx.rotate(cannonAngle);
            ctx.fillStyle = "#0f172a";
            ctx.fillRect(0, -6, 35, 12);
            ctx.restore();

            // Base del cañón
            ctx.fillStyle = "#451a03";
            ctx.beginPath();
            ctx.arc(cannonX, cannonY, 12, 0, Math.PI * 2);
            ctx.fill();

            // 5. NUEVO BARCO
            if (Math.random() < 0.025 && ships.length < 5) {
                ships.push(new Ship());
            }

            // Actualizar Barcos
            ships.forEach(s => {
                s.update();
                s.draw();
            });

            // 6. ANIMAR BALAS
            for (let i = shots.length - 1; i >= 0; i--) {
                let sh = shots[i];
                sh.x += sh.vx;
                sh.y += sh.vy;

                ctx.fillStyle = "#000000";
                ctx.beginPath();
                ctx.arc(sh.x, sh.y, 5, 0, Math.PI * 2);
                ctx.fill();

                // Colisión con Barcos
                for (let j = ships.length - 1; j >= 0; j--) {
                    let s = ships[j];
                    if (Math.abs(sh.x - s.x) < 30 && Math.abs(sh.y - s.y) < 20) {
                        s.hp -= 1;
                        shots.splice(i, 1);
                        createSparks(s.x, s.y);

                        if (s.hp <= 0) {
                            ships.splice(j, 1);
                            score += 1;
                            document.getElementById('ui-score').textContent = `${score} / ${TARGET_SCORE}`;
                            checkStoryTrigger();
                        }
                        break;
                    }
                }

                // Eliminar bala si sale
                if (sh.x < 0 || sh.y < 0 || sh.y > canvas.height) {
                    shots.splice(i, 1);
                }
            }

            // 7. PARTÍCULAS
            for (let i = particles.length - 1; i >= 0; i--) {
                let p = particles[i];
                p.x += p.vx;
                p.y += p.vy;
                p.life -= 1;
                ctx.fillStyle = p.color;
                ctx.beginPath();
                ctx.arc(p.x, p.y, 2, 0, Math.PI * 2);
                ctx.fill();
                if (p.life <= 0) particles.splice(i, 1);
            }

            // UI Cadenas
            chainHP = Math.max(0, chainHP);
            document.getElementById('ui-chain').textContent = `${Math.round(chainHP)}%`;

            if (chainHP <= 0 || score >= TARGET_SCORE) {
                endGame();
            } else {
                requestAnimationFrame(gameLoop);
            }
        }

        function endGame() {
            gameOver = true;
            document.getElementById('final-score').textContent = `${score} / ${TARGET_SCORE}`;
            document.getElementById('final-chain').textContent = `${Math.round(chainHP)}%`;
            
            if (score >= TARGET_SCORE) {
                document.getElementById('modal-title').textContent = "¡VICTORIA PATRIÓTICA TOTAL!";
                document.getElementById('modal-desc').textContent = "Has repelido los 100 ataques de la flota anglo-francesa y mantenido la firmeza del territorio nacional en las barrancas del Paraná.";
            } else {
                document.getElementById('modal-title').textContent = "¡RESISTENCIA HEROICA!";
                document.getElementById('modal-desc').textContent = "Las cadenas cedieron tras horas de combate impetuoso, pero la resistencia causó graves daños y obligó a las potencias a negociar la paz.";
            }

            document.getElementById('modal-edition').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('modal-edition').classList.add('hidden');
        }

        function resetGame() {
            chainHP = 100;
            score = 0;
            gameOver = false;
            gamePaused = false;
            currentChapterIndex = 0;
            ships = [];
            particles = [];
            shots = [];
            document.getElementById('ui-score').textContent = `0 / ${TARGET_SCORE}`;
            document.getElementById('ui-chain').textContent = "100%";
            resizeCanvas();
            requestAnimationFrame(gameLoop);
        }

        window.onload = () => {
            resizeCanvas();
            resetGame();
        };
    </script>
</body>
</html>
